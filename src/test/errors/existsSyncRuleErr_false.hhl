/*
    A test case for errors caused by a loops invariant which may not be preserved.
*/

method ExistsSyncRuleErr() returns (out: Int)
    requires exists <_s> :: true
    ensures exists <_s> :: _s[out] == 2
{
    var i: Int
    i := 0

    while existsRule (i < 1)
        invariant exists <_sa> :: forall <_s> :: _s[i] == 0
        decreases 1 - i
    {
        i := i + 1
    }

    out := 2
}

