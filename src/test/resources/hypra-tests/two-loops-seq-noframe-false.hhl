// VALID: false

method main(n: Int) returns (x: Int)
    requires exists <_s> :: _s[n] == 0
    requires forall <_s1>, <_s2> :: _s1[n] == _s2[n]
    ensures  exists <_s> :: _s[n] == 1
{
    var i: Int
    i := n

    // first loop: count down
    while (i > 0)
        invariant exists <_s> :: _s[i] == 0 && _s[n] == 0
        invariant forall <_s1>, <_s2> :: _s1[n] == _s2[n]
        invariant forall <_s> :: _s[i] <= _s[n]
        decreases i
    {
        i := i - 1
    }

    // second loop: count back up
    while (i < n)
        invariant exists <_s> :: _s[i] == 0 && _s[n] == 0
        invariant forall <_s> :: _s[i] <= _s[n]
        invariant forall <_s1>, <_s2> :: _s1[n] == _s2[n]
        decreases n - i
    {
        i := i + 1
    }
}