// VALID: true

method minimum (n: Int) returns (x: Int, y: Int)
    requires exists <_s> :: true
    requires forall <_s1>, <_s2> :: _s1[n] == _s2[n]
    ensures exists <_s1> :: (forall <_s2> :: _s1[x] <= _s2[x] && _s1[y] <= _s2[y])
{
    var i: Int
    var r: Int
    i := 0
    x := 0
    y := 0

    while syncTotRule (i < n)
        invariant forall <_s1>, <_s2> :: _s1[n] == _s2[n] && _s1[i] == _s2[i]
        invariant exists <_s1> :: (forall <_s2> :: _s1[x] <= _s2[x] && _s1[y] <= _s2[y])
        decreases n - i
    {
        r := 5 // actually nonDet, not yet implemented

        x := x + y + 2 * i + 3 * r
        y := x + 3 * i + 2 * r

        if (x >= n) {
            y := y + r
        }

        i := i + 1
    }
}