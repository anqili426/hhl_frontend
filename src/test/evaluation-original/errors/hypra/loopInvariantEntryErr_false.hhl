/*
    A simple test case for errors caused by a loops invariant which may not hold at entry point.
*/

method loopInvariantEntryErr() returns (out: Int)
    requires forall <_s> :: true
    ensures forall <_s> :: _s[out] == 2
{
    var i: Int
    i := 0

    while (i < 1)
        invariant forall <_s> :: false
    {
        i := i + 1
    }

    out := 2
}

