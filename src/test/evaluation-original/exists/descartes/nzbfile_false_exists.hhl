method compare1(o1: Seq[Bool], o2: Seq[Bool], fileName1: Int, fileName2: Int, subject1: Int, subject2: Int, i: Int) returns (res: Int)
requires forall <_s> :: |_s[o1]| == 5 && |_s[o2]| == 5
requires exists <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1] &&
    _s1[fileName1] == _s2[fileName2] && _s1[fileName2] == _s2[fileName1] &&
    _s1[subject1] == _s2[subject2] && _s1[subject2] == _s2[subject1]
ensures exists <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[res] == -1 * _s2[res]
{
    if (fileName1 != 0 && fileName2 != 0) {
        if (o1[0]) {
            res := -1000
        } else {
            if (o2[0]) {
                res := 1000
            } else {
                if (o1[1]) {
                    res := -999
                } else {
                    if (o2[1]) {
                        res := 1001
                    } else {
                        if (o1[2]) {
                            res := -998
                        } else {
                            if (o2[2]) {
                                res := 1002
                            } else {
                                if (o1[3]) {
                                    res := -997
                                } else {
                                    if (o2[3]) {
                                        res := -1003
                                    } else {
                                        if (o1[4]) {
                                            res := -996
                                        } else {
                                            if (o2[4]) {
                                                res := 1004
                                            } else {
                                                // normal comparision
                                                if (fileName1 < fileName2) {
                                                    res := -1
                                                } else {
                                                    if (fileName1 == fileName2) {
                                                        res := 0
                                                    } else {
                                                        res := 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        if (fileName1 != 0 && fileName2 == 0) {
            res := -995
        } else {
            if (fileName1 == 0 && fileName2 != 0) {
                res := 1005
            } else {
                if (subject1 < subject2) {
                    res := -1
                } else {
                    if (subject1 == subject2) {
                        res := 0
                    } else {
                        res := 1
                    }
                }
            }
        }
    }
}