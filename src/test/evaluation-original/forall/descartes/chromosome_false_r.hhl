// TODO:

// P1
// The chromosomes are modeled as sequences of integers, which each integer representing a specific score.
// Some modifications to resemble the behaviour:
// - Null means the sequence is empty
// - The score is resembled by the index of the sequence, each sequence has a length of 5
method compare1(o1: Seq[Int], o2: Seq[Int], i: Int) returns (res: Int)
requires forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1]
requires forall <_s> :: (|_s[o1]| == 0 || |_s[o1]| == 5) && (|_s[o2]| == 0 || |_s[o2]| == 5)

ensures forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[res] == -1 * _s2[res]
{
    // hyperAssume forall <_s> :: _s[i] == 1 ==> |_s[o1]| == 5
    // hyperAssume forall <_s> :: _s[i] == 2 ==> |_s[o2]| == 5

    if (|o2| == 0 || |o1| == 0) {
        res := 0
    } else {
        var comp: Int
        comp := 0

        if (o1[0] > o2[0]) {
            comp := comp + 1
        } else {
            if (o1[0] < o2[0]) {
                comp := comp - 1
            }
        }

        if (o1[1] > o2[1]) {
            comp := comp + 1
        } else {
            if (o1[1] < o2[1]) {
                comp := comp - 1
            }
        }

        if (o1[2] > o2[2]) {
            comp := comp + 1
        } else {
            if (o1[2] < o2[2]) {
                comp := comp - 1
            }
        }

        if (o1[3] > o2[3]) {
            comp := comp + 1
        } else {
            if (o1[3] < o2[3]) {
                comp := comp - 1
            }
        }

        if (o1[4] > o2[4]) {
            comp := comp + 1
        } else {
            if (o1[4] < o2[4]) {
                comp := comp - 1
            }
        }

        if (comp == 0) {
            res := 0
        } else {
            if (comp > 0) {
                res := 1
            } else {
                res := -1
            }
        }
    }
}