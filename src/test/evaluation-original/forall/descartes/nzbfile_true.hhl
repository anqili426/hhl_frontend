/*
 * Based on http://sohu.io/questions/2211707/comparison-method-violates-its-general-contract
 * 
 */

// P1
method compare1(o1: Seq[Bool], o2: Seq[Bool], fileName1: Int, fileName2: Int, subject1: Int, subject2: Int, i: Int) returns (res: Int)
requires forall <_s> :: |_s[o1]| == 5 && |_s[o2]| == 5
requires forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1] &&
    _s1[fileName1] == _s2[fileName2] && _s1[fileName2] == _s2[fileName1] &&
    _s1[subject1] == _s2[subject2] && _s1[subject2] == _s2[subject1]
ensures forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[res] == -1 * _s2[res]
{
    res := 0

    if (o1 == o2) {
        res := 0
    } else {
        if (fileName1 != 0 && fileName2 != 0) {
            var j: Int
            j := 0

            var exit: Bool
            exit := false

            while (j < 5 && !exit)
            invariant forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
                _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1] &&
                _s1[fileName1] == _s2[fileName2] && _s1[fileName2] == _s2[fileName1] &&
                _s1[subject1] == _s2[subject2] && _s1[subject2] == _s2[subject1] &&
                _s1[j] == _s2[j]
            invariant forall <_s1>, <_s2> :: (_s1[i] == 1 && _s2[i] == 2) ==>
                ((_s1[o1])[_s1[j]] == (_s2[o2])[_s2[j]] && (_s1[o2])[_s1[j]] == (_s2[o1])[_s2[j]])
            invariant forall <_s> :: (_s[exit] == true) ==>
                ((_s[o1])[_s[j]] && (_s[o2])[_s[j]] && _s[res] == 0) ||
                ((_s[o1])[_s[j]] && !((_s[o2])[_s[j]]) && _s[res] == -1000 + _s[j]) ||
                (!((_s[o1])[_s[j]]) && (_s[o2])[_s[j]] && _s[res] == 1000 + _s[j])
            invariant forall <_s> :: (_s[exit] == false) ==>
                (_s[j] == 0 && _s[res] == 0 && (((_s[o1])[_s[j]]) || ((_s[o2])[_s[j]]))) ||
                (_s[j] > 0 && _s[res] == 0 && !((_s[o1])[_s[j-1]]) && !((_s[o2])[_s[j-1]]))
            {
                if (o1[j] && o2[j]) {
                    res := 0
                    exit := true
                } else {
                    if (o1[j]) {
                        res := -1000 + j
                        exit := true
                    } else {
                        if (o2[j]) {
                            res := 1000 + j
                            exit := true
                        } else {
                            j := j + 1
                        }
                    }
                }
            }

            if (!exit) {
                if (fileName1 < fileName2) {
                res := -1
            } else {
                if (fileName1 == fileName2) {
                    res := 0
                } else {
                    res := 1
                }
            }
            exit := true
            
            } else {
                if (fileName1 != 0 && fileName2 == 0) {
                    res := -995
                } else {
                    if (fileName1 == 0 && fileName2 != 0) {
                        res := 1005
                    } else {
                        if (subject1 < subject2) {
                            res := -1
                        } else {
                            if (subject1 == subject2) {
                                res := 0 
                            } else { 
                                res := 1
                            }
                        }
                    }
                }
            }
        }
    }
}