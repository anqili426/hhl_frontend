method testSequences(s1: Seq[Int]) returns (o: Int, b: Bool)
requires exists <_s> :: true
ensures exists <_s> :: _s[o] == 1 && !_s[b]
// ensures exists <_s> :: false
{
    // offering two paths for specialised testing
    var pathSelect: Int
    havoc pathSelect {pathHint}
    use pathHint(1)
    use pathHint(-1)

    o := pathSelect

    if (pathSelect > 0) {
        var s: Seq[Int]
        s := Seq[Int](1,2,3,4)

        b := 2 == s[1]

        hyperAssert exists <_s> :: _s[o] == 1 && _s[b]
        hyperAssert exists <_s> :: _s[o] == 1 && !_s[b]
    } else {
        b := false

        hyperAssert exists <_s> :: _s[o] == 1 && _s[b]
        hyperAssert exists <_s> :: _s[o] == 1 && !_s[b]
    }


    hyperAssert exists <_s> :: _s[o] == 1 && _s[b]
    hyperAssert exists <_s> :: _s[o] == 1 && !_s[b]

}