method basicFunctionality(b: Bool) returns (res: Bool)
requires forall <_s> :: !_s[b]
ensures forall <_s> :: _s[res]
{
    res := !b
}

method moreComplex(b1: Bool, b2: Bool) returns (res: Bool)
requires forall <_s> :: !(_s[b1] && _s[b2]) && (_s[b1] || _s[b2])
ensures forall <_s> :: _s[res]
{
    var t1: Bool
    t1 := b1 && true
    var t2: Bool
    t2 := b2 && true

    res := t1 || t2
}

method nonDeterministic(b1: Bool, b2: Bool, i: Int) returns (res: Bool)
requires exists <_s> :: (_s[b1] && _s[b2]) && (_s[i] == 0 || _s[i] == 1)
ensures exists <_s> :: _s[res]
{
    if (i == 0) {
        res := b1
    } else {
        res := b2
    }
}
