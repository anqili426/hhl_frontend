/*
    A simple program to test sets.
*/

method testSets(in: Int) returns ()
requires forall <_s> :: true
ensures forall <_s> :: true
{
    var set: Set[Int]
    set := Set[Int]()
    hyperAssert forall <_s> :: |_s[set]| == 0

    set := Set[Int](1,2,3,4)

    hyperAssert forall <_s> :: |_s[set]| == 4
    hyperAssert forall <_s> :: 1 in _s[set]

    var s1: Set[Int]
    var s2: Set[Int]

    s1 := Set[Int](1,2)
    s2 := Set[Int](2,3)

    var sun: Set[Int]
    var sin: Set[Int]
    var sdiff: Set[Int]

    sun := s1 union s2
    sin := s1 intersection s2
    sdiff := s1 setminus s2

    hyperAssert forall <_s> :: _s[sun] == Set[Int](1,2,3)
    hyperAssert forall <_s> :: _s[sin] == Set[Int](2)
    hyperAssert forall <_s> :: _s[sdiff] == Set[Int](1)

    var s3: Set[Set[Int]]
    s3 := Set[Set[Int]](sun, sin)

    hyperAssert forall <_s> :: |_s[s3]| == 2
    hyperAssert forall <_s> :: _s[sun] in _s[s3]
    hyperAssert forall <_s> :: _s[sin] in _s[s3]
    hyperAssert forall <_s> :: !(_s[sdiff] in _s[s3])
}
