/*
    A simple program to test sequences.
*/

// TODO: Why do we support quantifiers in HyperAssertions, but not in regular assertions?

method testBasicDeclarations(e1: Int, e2: Int, e3: Int) returns (res: Seq[Int])
requires forall <_s> :: true
ensures forall <_s> :: _s[res] == Seq[Int](_s[e1], _s[e2], _s[e3])
{
    var s: Seq[Int]
    s := Seq[Int](e1, e2, e3)
    res := s
}

method testOutOfBounds(s1: Seq[Int]) returns ()
requires forall <_s> :: |_s[s1]| == 1
ensures forall <<_s>> :: true 
{
    var i: Int
    i := s1[2]

    assert false
}

method testMethods() returns ()
requires forall <_s> :: true
ensures forall <_s> :: true
{
    var s2: Seq[Int]
    s2 := Seq[Int](1, 2)

    hyperAssert forall <_s> :: |_s[s2]| == 2

    var s3: Seq[Int]
    s3 := s2 ++ s2
    hyperAssert forall <_s> :: |_s[s3]| == 4
    hyperAssert forall <_s> :: _s[s3][1] == _s[s3][3]
}

method findMaxInSeq(seq: Seq[Int], l: Int) returns (res: Int)
requires forall <_s> :: _s[seq] != Seq[Int]() && _s[l] == |_s[seq]|
ensures forall <_s> :: forall _i: Int :: (_i >= 0 && _i < _s[l]) ==> (_s[seq][_i] <= _s[res])
{
    var max: Int
    max := seq[0]

    var i: Int
    i := 1

    while (i < l)
        invariant forall <_s> :: forall _j: Int :: ((_j >= 0 && _j < _s[i]) ==> _s[seq][_j] <= _s[max])
        invariant forall <_s> :: 0 <= _s[i] && _s[i] <= _s[l]
        decreases l - i
    {
        if (seq[i] > max) {
            max := seq[i]
        }
        i := i + 1
    }

    res := max
}

