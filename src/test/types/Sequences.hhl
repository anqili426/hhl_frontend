/*
    A simple program to test sequences.
*/

method testSequences() returns ()
requires forall <_s> :: true
ensures forall <_s> :: true
{
    // Testing Sequences
    var s1: Seq[Int]
    var s2: Seq[Int]
    var s3: Seq[Int]

    s1 := Seq[Int](1, 2)
    s2 := Seq[Int](3, 4)

    s3 := s1 ++ s2
    hyperAssert forall <_s> :: _s[s3] == Seq[Int](1, 2, 3, 4)

    var l: Int
    l := |s3|
    hyperAssert forall <_s2> :: _s2[l] == 4

    hyperAssume forall <_s> :: |_s[s3]| == 4
    var s3_1: Int
    s3_1 := s3[1]
    hyperAssert forall <_s> :: _s[s3_1] == 2

    var ss: Seq[Seq[Int]]
    ss := Seq[Seq[Int]](s1, s2, s3)
    hyperAssert forall <_s> :: _s[ss] == Seq[Seq[Int]](Seq[Int](1,2), Seq[Int](3,4), Seq[Int](1,2, 3, 4))
}
