
// P1
// The chromosomes are modeled as sequences of integers, which each integer representing a specific score.
// Some modifications to resemble the behaviour:
// - Null means the sequence is empty
// - The score is resembled by the index of the sequence, each sequence has a length of 5
method compare1(o1: Seq[Int], o2: Seq[Int], i: Int) returns (res: Int)
requires forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1]
requires forall <_s> :: |_s[o1]| == 5 && (|_s[o2]| == 0 || |_s[o2]| == 5)
ensures forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[res] == -1 * _s2[res]
{
    // TODO: Add this as a precondition
    // hyperAssume forall <_s> :: _s[i] == 1 ==> |_s[o1]| == 5
    // hyperAssume forall <_s> :: _s[i] == 2 ==> |_s[o2]| == 5

    if (|o2| == 0) {
        res := 1
    } else {
        if (|o1| == 0) {
            res := -1
        } else {
            res := 0

            var index: Int
            index := 0

            var exit: Bool
            exit := false

            while (i < 5 && !exit) 
            invariant forall <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
                                            _s1[o1] == _s2[o2] && _s1[o2] == _s2[o1] && _s1[index] == _s2[index]
            invariant forall <_s1>, <_s2> :: (_s1[i] == 1 && _s2[i] == 2) ==>
                                            ((_s1[o1])[_s1[index]] == (_s2[o2])[_s2[index]] && (_s1[o2])[_s1[index]] == (_s2[o1])[_s2[index]])

            invariant forall <_s> :: (_s[exit] == true) ==> ((_s[o1])[_s[index]] > (_s[o2])[_s[index]] && _s[res] == 1) ||
                                                                ((_s[o1])[_s[index]] < (_s[o2])[_s[index]] && _s[res] == -1)
            invariant forall <_s> :: (_s[exit] == false) ==> (((_s[o1])[_s[index]] != (_s[o2])[_s[index]] && _s[res] == 0 && _s[index] == 0)) ||
                                                                (((_s[o1])[_s[index-1]] == (_s[o2])[_s[index-1]] && _s[res] == 0 && _s[index] > 0))
            {
                if (o1[index] > o2[index]) {
                    res := 1
                    exit := true
                } else {
                    if (o1[index] < o2[index]) {
                        res := -1
                        exit := true
                    } else {
                        index := index + 1
                    }
                }
            }
        }
    }
}