/*
 * Based on http://stackoverflow.com/questions/23907134/comparing-two-arrays-using-dictionary-order-in-an-array-of-arrays-java
 * 
 */

// P2
method compare2(arr1: Seq[Int], arr2: Seq[Int], i: Int) returns (res: Int)
requires forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
    _s1[arr1] == _s3[arr1] && _s1[arr2] == _s2[arr1] && _s2[arr2] == _s3[arr2]

requires forall <_s> :: |_s[arr1]| == |_s[arr2]|
requires forall <_s1>, <_s2> :: |_s1[arr1]| == |_s2[arr1]| && |_s1[arr2]| == |_s2[arr2]|

ensures forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
    (_s1[res] > 0 && _s2[res] > 0 ==> _s3[res] > 0)
{
    var index: Int
    index := 0

    var aEntry: Int
    var bEntry: Int

    var exit: Bool
    exit := false

    res := 0
    aEntry := 0
    bEntry := 0

    while ((index < |arr1|) && (index < |arr2|) && (!exit))
        // Transitivity assumption
        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            _s1[arr1] == _s3[arr1] && _s1[arr2] == _s2[arr1] && _s2[arr2] == _s3[arr2]

        // All have same size
        invariant forall <_s> :: |_s[arr1]| == |_s[arr2]|
        invariant forall <_s1>, <_s2> :: |_s1[arr1]| == |_s2[arr1]| && |_s1[arr2]| == |_s2[arr2]|

        // exit and res != 0 is the same
        invariant forall <_s> :: (_s[res] != 0) == _s[exit]

        // not exited: synchronized
        invariant forall <_s1>, <_s2> :: !_s1[exit] && !_s2[exit] ==> _s1[index] == _s2[index]

        // All cases
        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] == 0 && _s2[res] == 0 ==> _s3[res] == 0)

        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] == 0 && _s2[res] > 0 ==> _s3[res] > 0)

        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] == 0 && _s2[res] < 0 ==> _s3[res] < 0)


        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] > 0 && _s2[res] == 0 ==> _s3[res] > 0)
        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] < 0 && _s2[res] == 0 ==> _s3[res] < 0)

        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            _s3[res] == 0 ==> ((_s1[res] == 0 && _s2[res] == 0) || (_s1[res] > 0 && _s2[res] < 0) || (_s1[res] < 0 && _s2[res] > 0))

        // Goal
        invariant forall <_s1>, <_s2>, <_s3> :: _s1[i] == 1 && _s2[i] == 2 && _s3[i] == 3 ==>
            (_s1[res] > 0 && _s2[res] > 0 ==> _s3[res] > 0)

    {
        aEntry := arr1[index]
        bEntry := arr2[index]
        
        if (aEntry < bEntry) {
            res := -1
            exit := true
        } else {
            if (aEntry > bEntry) {
                // res becomes 1 here
                res := 1
                exit := true
            } else {
                index := index + 1
            }
        }

    }

    if (!exit) {
        if (|arr1| < |arr2|) {
            res := -1
        } else {
          if (|arr1| > |arr2|) {
             res := 1
          } else {
             res := 0
          }
        }
    }
}
