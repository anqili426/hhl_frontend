method fibonacci(n: Int, t: Int) returns (res: Int)
    requires forall <_s1>, <_s2> :: _s1[t] == 1 && _s2[t] == 2 ==> _s1[n] >= _s2[n]
    ensures forall <_s1>, <_s2> :: _s1[t] == 1 && _s2[t] == 2 ==> _s1[res] >= _s2[res]
{
        var a: Int
        var b: Int
        var tmp: Int
        var i: Int

        a := 0
        b := 1
        i := 0

        while (i < n)
            invariant forall <_s1>, <_s2> :: _s1[t] == 1 && _s2[t] == 2 ==> (_s1[n] - _s1[i] >= _s2[n] - _s2[i] && _s1[a] >= _s2[a] && _s1[b] >= _s2[b] && (forall <_s3> :: _s3[b] >= _s3[a] && _s3[a] >= 0))
        {
            tmp := b
            b := a + b
            a := tmp
            i := i + 1
        }

        res := a
}