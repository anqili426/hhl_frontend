method alternative(arr1: Seq[Int], arr2: Seq[Int], i: Int) returns (res: Int)
requires exists <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
    _s1[arr1] == _s2[arr2] && _s1[arr2] == _s2[arr1]
requires forall <_s> :: |_s[arr1]| == |_s[arr2]| && |_s[arr1]| > 0
ensures exists <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 &&
    !((_s1[res] > 0 && _s2[res] < 0) || (_s1[res] < 0 && _s2[res] > 0) || (_s1[res] == 0 && _s2[res] == 0))
{
    var i1: Int
    i1 := 0

    var exit: Bool
    exit := false

    var aEntry: Int
    var bEntry: Int
    aEntry := 0
    bEntry := 0

    while (i1 < |arr2| && !exit)
    invariant exists <_s1>, <_s2> :: _s1[i] == 1 && _s2[i] == 2 ==>
                                    _s1[arr1] == _s2[arr2] && _s1[arr2] == _s2[arr1] && _s1[i1] == _s2[i1]
    invariant exists <_s1>, <_s2> :: (_s1[i] == 1 && _s2[i] == 2) ==>
                                    (_s1[aEntry] == _s2[bEntry] && _s1[bEntry] == _s2[aEntry])

    invariant exists <_s> :: (_s[exit] == false) ==> 
                            (_s[aEntry] == _s[bEntry] && _s[res] == 0)
    invariant exists <_s> :: (_s[exit] == true) ==> 
                            ((_s[aEntry] > _s[bEntry] && _s[res] == 1) || (_s[aEntry] < _s[bEntry] && _s[res] == -1))
    decreases |arr2| - i1
    {
        aEntry := arr1[i1]
        bEntry := arr2[i1]

        if (aEntry < bEntry) {
            res := 1
            exit := true
        } else {
            i1 := i1 + 1
        }
    }

    res := -1
    exit := true
}