/*
    A test case for errors caused by an invariant which doesn't hold after applying existsRule, stripping a quantifier, and then applying forallExistsRule.
*/

method bla(n: Int) returns ()
    requires exists <_s> :: true
    ensures exists <_s> :: true
{
    var i: Int
    var r: Int

    havoc i {hint1}
    use hint1(-1)
    use hint1(1)

    while (i >= 0 && i < n)
        invariant exists <_s1> :: forall <_s2> :: _s2[i] >= 0
        decreases n - i
    {
        havoc i {hint2}
        use hint2(-1)
        use hint2(1)

        i := i + 1
    }
}


