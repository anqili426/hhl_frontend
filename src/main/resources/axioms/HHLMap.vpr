domain HHLMap[K, V] {
  function HHLMap_apply(m : HHLMap[K, V], k : K) : V
  function HHLMap_card(m : HHLMap[K, V]) : Int
  function HHLMap_disjoint(m1 : HHLMap[K, V], m2 : HHLMap[K, V]) : Bool
  function HHLMap_domain(m : HHLMap[K, V]) : Set[K]
  function HHLMap_empty() : HHLMap[K, V]
  function HHLMap_equal(m1 : HHLMap[K, V], m2 : HHLMap[K, V]) : Bool
  function HHLMap_update(m : HHLMap[K, V], k : K, v : V) : HHLMap[K, V]
  function HHLMap_values(m : HHLMap[K, V]) : Set[V]

  function HHLMap_range_domain_skolem(m : HHLMap[K, V], v : V) : K

  /* ** Cardinality */

  axiom {
    forall m : HHLMap[K, V] :: { HHLMap_card(m) } 0 <= HHLMap_card(m)
  }

  /* added second trigger set */
  axiom {
    forall m : HHLMap[K, V] :: { |HHLMap_domain(m)| } {HHLMap_card(m)} |HHLMap_domain(m)| == HHLMap_card(m)
  }

  /* ** Disjointness */

  /* split in both directions */
  axiom {
    forall m1 : HHLMap[K, V], m2 : HHLMap[K, V] :: { HHLMap_disjoint(m1, m2) }
      HHLMap_disjoint(m1, m2) ==>
        (forall k : K :: { k in HHLMap_domain(m1) } {k in HHLMap_domain(m2) }
          !(k in HHLMap_domain(m1)) || !(k in HHLMap_domain(m2)))
  }

  axiom {
    forall m1 : HHLMap[K, V], m2 : HHLMap[K, V] :: { HHLMap_disjoint(m1, m2) }
      !HHLMap_disjoint(m1, m2) ==>
        (exists k : K :: (k in HHLMap_domain(m1)) && (k in HHLMap_domain(m2)))
  }

  /* ** Empty */
  axiom {
    forall k : K :: { k in HHLMap_domain((HHLMap_empty() : HHLMap[K, V])) }
      !(k in HHLMap_domain((HHLMap_empty() : HHLMap[K, V])))
  }

  /* split last part in both directions */
  axiom {
    forall m : HHLMap[K, V] :: { HHLMap_card(m) }
      (HHLMap_card(m) == 0 <==> m == HHLMap_empty()) &&
      (HHLMap_card(m) != 0 ==> exists u : K :: u in HHLMap_domain(m)) &&
      (forall u : K :: {u in HHLMap_domain(m)} u in HHLMap_domain(m) ==> HHLMap_card(m) != 0)
  }

  /* Equality */
  // this axiom is only needed in one direction; the other is implied by the next axiom
    axiom {
      forall m1 : HHLMap[K, V], m2 : HHLMap[K, V] :: { HHLMap_equal(m1, m2) }
          ((forall k : K :: { k in HHLMap_domain(m1) } { k in HHLMap_domain(m2) } k in HHLMap_domain(m1) <==> k in HHLMap_domain(m2)) &&
           (forall k : K :: { HHLMap_apply(m1, k) } { HHLMap_apply(m2, k) } k in HHLMap_domain(m1) ==> HHLMap_apply(m1, k) == HHLMap_apply(m2, k)))
             ==>  HHLMap_equal(m1, m2)
    }

  axiom {
    forall m1 : HHLMap[K, V], m2 : HHLMap[K, V] :: { HHLMap_equal(m1, m2) }
      HHLMap_equal(m1, m2) ==> m1 == m2
  }

  /* ** Update */

/* added second trigger set (cf. example3 test case, test3)
/* could also add {HHLMap_update(m,k1,v), HHLMap_apply(m,k1)} as another alternative trigger, but seems subsumed given that we need to know k2 is in a domain */
  axiom {
    forall m : HHLMap[K, V], k1 : K, k2 : K, v : V ::
      { k2 in HHLMap_domain(HHLMap_update(m, k1, v)) } {k2 in HHLMap_domain(m), HHLMap_update(m, k1, v)} { HHLMap_apply(HHLMap_update(m, k1, v), k2) }
        (k1 == k2 ==> k2 in HHLMap_domain(HHLMap_update(m, k1, v)) && HHLMap_apply(HHLMap_update(m, k1, v), k2) == v) &&
        (k1 != k2 ==> (k2 in HHLMap_domain(HHLMap_update(m, k1, v)) <==> k2 in HHLMap_domain(m)) && (k2 in HHLMap_domain(m) ==> HHLMap_apply(HHLMap_update(m, k1, v), k2) == HHLMap_apply(m, k2)))
  }

/* added second trigger set (not sure of a test case needing it, though) */
  axiom {
    forall m : HHLMap[K, V], k : K, v : V :: { HHLMap_card(HHLMap_update(m, k, v)) } { HHLMap_card(m), HHLMap_update(m, k, v)}
      (k in HHLMap_domain(m) ==> HHLMap_card(HHLMap_update(m, k, v)) == HHLMap_card(m)) &&
      (!(k in HHLMap_domain(m)) ==> HHLMap_card(HHLMap_update(m, k, v)) == HHLMap_card(m) + 1)
  }

  /* ** Values */
  /* split axiom into each direction */
//  axiom {
//    forall m : HHLMap[K, V], v : V :: { v in HHLMap_values(m) }
//      v in HHLMap_values(m) ==>
//        exists k : K :: { k in HHLMap_domain(m) } { HHLMap_apply(m, k) }
//          k in HHLMap_domain(m) && v == HHLMap_apply(m, k)
//  }
  axiom {
    forall m : HHLMap[K, V], v : V :: { v in HHLMap_values(m) }
      v in HHLMap_values(m) ==>
          HHLMap_range_domain_skolem(m,v) in HHLMap_domain(m) && v == HHLMap_apply(m, HHLMap_range_domain_skolem(m,v))
  }

  axiom {
    forall m : HHLMap[K, V], k : K :: { HHLMap_apply(m, k) } { k in HHLMap_domain(m) }
       (k in HHLMap_domain(m)
          ==> |HHLMap_values(m)| > 0) // weaker than the axiom below, but with weaker triggering
  }

  /* no need for an "in" term to match this one; cf. example3 test case test5 */
  axiom {
    forall m : HHLMap[K, V], k : K :: { HHLMap_apply(m, k) } // { k in HHLMap_domain(m) }  // REMOVED trigger - this can create issues if several maps share the domain
       (k in HHLMap_domain(m)
          ==> HHLMap_apply(m, k) in HHLMap_values(m))
  }
  // There's a potential for matching loops with the extra trigger if two maps have equal domains:
  // v in range(m1); some k in dom(m1) = dom(m2) s.t. m1[k] = v; m2[k] in range(m2); some k' in dom(m2) s.t. m2[k'] = m2[k]

}